{% extends 'base.html.twig' %}

{% block title %}My Account{% endblock %}

{% block body %}
    <h1>My Account</h1>
    <img src="{{ app.user.imageName }}" alt="Profile picture" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover;">
    <p>{{ app.user.firstname }} {{ app.user.lastname }}</p>
    <p>{{ app.user.email }}</p>
    <a href="{{ path('app_account_edit') }}">Edit my profile</a>
{% endblock %}