{% extends 'base.html.twig' %}

{% block title %}Pin{% endblock %}

{% block body %}
    <h1>Pin</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ pin.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ pin.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ pin.description }}</td>
            </tr>
            <tr>
                <th>ImageName</th>
                <td>{{ pin.imageName }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ pin.createdAt ? pin.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ pin.updatedAt ? pin.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_pin_index') }}">back to list</a>

    <a href="{{ path('app_pin_edit', {'id': pin.id}) }}">edit</a>

    {{ include('pin/_delete_form.html.twig') }}
{% endblock %}
