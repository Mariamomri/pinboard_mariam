{% extends 'base.html.twig' %}

{% block title %}All Pins{% endblock %}

{% block body %}
{% set nbPins = pins|length %}
    <h1 align="center">All Pins ({{ nbPins }})</h1>
    <div class="row">
        {% for pin in pins %}
            <div class="card col-4 my-3 mx-2" style="max-width: 270px;">
                <a href="{{ path('app_pin_show', {id: pin.id}) }}">
                    <img src="{{ pin.imageName }}" class="card-img-top" alt="{{ pin.title }}" style="width: 250px; height: 250px; object-fit: cover;">
                </a>
                <div class="card-body">
                    <h5 class="card-title">
                        <a href="{{ path('app_pin_show', {id: pin.id}) }}">{{ pin.title|u.truncate(30, '...', false) }}</a>
                    </h5>
                    <p class="card-text">Posted {{ pin.createdAt|ago }}</p>
                    <p class="card-text">By {{ pin.user.firstname ~ " " ~ pin.user.lastname }}</p>
                </div>
            </div>
        {% else %}
            <p>No pins yet.</p>
        {% endfor %}
    </div>
{% endblock %}